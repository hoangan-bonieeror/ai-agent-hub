# Copy to .env and adjust. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://hub:hub@localhost:5432/agent_hub
REDIS_URL=redis://localhost:6379/0
# Only needed when an agent uses runtime "openai_agents"
OPENAI_API_KEY=
DEFAULT_TASK_TIMEOUT_SECONDS=120
DEFAULT_MAX_STEPS=10
# Most workflow steps that run at once in one run
WORKFLOW_MAX_PARALLEL=4
# Development only: serve agents with runtime "fake" (no model calls)
ENABLE_FAKE_RUNTIME=false
# Let MCP servers with transport "stdio" start local programs (off: the API has no login yet)
MCP_ALLOW_STDIO=false
# Throwaway database for DB-backed tests (they skip when unset)
TEST_DATABASE_URL=
